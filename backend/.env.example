# Example Environment Variables
# Copy this file to src/.env and fill in the values

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-strong-secret-min-8-chars

# Firebase (Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Path relative to backend root or absolute
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/firebase-admin.json
# Alternatively, provide raw credentials:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google AI (Gemini)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Email (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=hr@yourdomain.com
BREVO_FROM_NAME=JrGuide HR Team
BREVO_INVITE_TEMPLATE_ID=
BREVO_REMINDER_TEMPLATE_ID=
BREVO_COMPLETION_TEMPLATE_ID=
